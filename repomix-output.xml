    a, b = html.index(g.INICIO), html.index(g.FIN) + len(g.FIN)
    assert html[a:b].replace("\r\n", "\n") == g.panel()
    panel = _panel(html, "hogares")
    for prov in JUNTAS_POR_PROVINCIA:          # las 24 jurisdicciones tienen fila
