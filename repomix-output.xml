            <span class="ep">educational, sourced</span>
          </div>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section style="background:var(--paper); border-top:1px solid var(--paper-line); border-bottom:1px solid var(--paper-line);">
      <div class="wrap">
        <div class="section-head">
